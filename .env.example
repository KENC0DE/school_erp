# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
DEV_MODE=true

# School instance
DATABASE_URL=sqlite+aiosqlite:///./data/erp_demo.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-only-change-me-please-0123456789abcdef
REFRESH_SECRET=dev-only-change-me-too-0123456789abcdef
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@demo.school

# Controller link
CONTROLLER_URL=http://localhost:8100
CONTROLLER_PUBLIC_KEY=
INSTANCE_ID=
ENROLLMENT_TOKEN=
HEARTBEAT_SECONDS=60
AUDIT_SHIP_BATCH=100

# Control plane
CONTROLLER_DATABASE_URL=sqlite+aiosqlite:///./data/controller.db
CONTROLLER_SECRET_KEY=controller-dev-only-change-me-0123456789
CONTROLLER_PUBLIC_BASE_URL=http://localhost:8100
CONTROLLER_API_BASE_URL=http://localhost:8100
# Generated on first start when empty; used by the mobile app as trust anchor.
DIRECTORY_PRIVATE_KEY=
DIRECTORY_KID=k1

# Frontends
VITE_API_URL=http://localhost:8000
VITE_CONTROLLER_API_URL=http://localhost:8100
EXPO_PUBLIC_CONTROLLER_URL=http://localhost:8100
