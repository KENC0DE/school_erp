{
  "$comment": "Shared conformance corpus for the version 1 document layout. The TypeScript (Zod) and Python (Pydantic) suites both validate this file, so a schema change that only lands on one side fails here. 'valid' entries must parse and survive a round-trip; 'invalid' entries must be rejected.",
  "valid": [
    {
      "name": "minimal A4 page",
      "layout": {
        "version": 1,
        "page": { "size": "A4" }
      }
    },
    {
      "name": "certificate with every element kind",
      "layout": {
        "version": 1,
        "name": "Certificate of completion",
        "page": {
          "size": "A4",
          "orientation": "landscape",
          "margins_mm": { "top": 15, "right": 15, "bottom": 20, "left": 15 },
          "bleed_mm": 3,
          "background_colour": "#fdfaf3"
        },
        "fonts": [
          { "family": "Noto Sans Ethiopic", "fallback": "Inter" },
          {
            "family": "Inter",
            "file_id": "3f0e8f5e-2c2f-4d3c-9b0a-5b6f6b7c8d9e"
          }
        ],
        "elements": [
          {
            "id": "title",
            "type": "text",
            "rect": { "x_mm": 15, "y_mm": 20, "w_mm": 267, "h_mm": 20 },
            "z": 1,
            "content": "Certificate of Completion",
            "style": {
              "font_family": "Noto Sans Ethiopic",
              "font_size_pt": 28,
              "bold": true
            },
            "align": "center",
            "format": { "script": "both" }
          },
          {
            "id": "student_name",
            "type": "text",
            "rect": { "x_mm": 15, "y_mm": 60, "w_mm": 267, "h_mm": 14 },
            "content": "{{student.full_name}}",
            "style": {
              "font_family": "Noto Sans Ethiopic",
              "font_size_pt": 22,
              "italic": true
            },
            "align": "center",
            "vertical_align": "middle"
          },
          {
            "id": "promoted_note",
            "type": "text",
            "rect": { "x_mm": 15, "y_mm": 80, "w_mm": 267, "h_mm": 10 },
            "content": "Promoted to {{student.next_grade}}",
            "style": { "font_family": "Inter", "font_size_pt": 12 },
            "align": "center",
            "visible_when": {
              "all": [
                { "op": "eq", "field": "student.status", "value": "promoted" },
                {
                  "any": [
                    { "op": "exists", "field": "student.rank" },
                    { "op": "gte", "field": "student.total", "value": 50 }
                  ]
                }
              ]
            }
          },
          {
            "id": "photo",
            "type": "image",
            "rect": { "x_mm": 15, "y_mm": 15, "w_mm": 25, "h_mm": 30 },
            "source": { "kind": "field", "value": "student.photo" },
            "fit": "cover",
            "alt": "Student photograph"
          },
          {
            "id": "logo",
            "type": "image",
            "rect": { "x_mm": 247, "y_mm": 15, "w_mm": 35, "h_mm": 20 },
            "source": { "kind": "url", "value": "https://erp.local/logo.png" },
            "fit": "contain"
          },
          {
            "id": "rule",
            "type": "shape",
            "rect": { "x_mm": 15, "y_mm": 52, "w_mm": 267, "h_mm": 0.5 },
            "shape": "line",
            "stroke": { "colour": "#8b5e3c", "width_mm": 0.6 }
          },
          {
            "id": "marks",
            "type": "table",
            "rect": { "x_mm": 15, "y_mm": 110, "w_mm": 267, "h_mm": 80 },
            "table": {
              "source": "student.marks.subjects",
              "row_height_mm": 7,
              "columns": [
                {
                  "key": "subject",
                  "label": "Subject",
                  "binding": "subject",
                  "width_mm": 120
                },
                {
                  "key": "score",
                  "label": "Score",
                  "binding": "score",
                  "width_mm": 40,
                  "align": "right",
                  "format": { "number_decimals": 2 }
                },
                {
                  "key": "grade",
                  "label": "Grade",
                  "binding": "grade",
                  "width_mm": 30,
                  "align": "center"
                }
              ],
              "summaries": [
                { "column": "score", "aggregate": "sum", "label": "Total" },
                {
                  "column": "score",
                  "aggregate": "average",
                  "label": "Average"
                },
                { "column": "subject", "aggregate": "count", "label": "Subjects" }
              ]
            },
            "style": { "font_family": "Inter", "font_size_pt": 10 }
          },
          {
            "id": "verify_qr",
            "type": "qr",
            "rect": { "x_mm": 250, "y_mm": 200, "w_mm": 25, "h_mm": 25 },
            "data": "https://erp.local/verify/{{document.code}}",
            "error_correction": "H"
          },
          {
            "id": "serial",
            "type": "barcode",
            "rect": { "x_mm": 15, "y_mm": 205, "w_mm": 60, "h_mm": 15 },
            "data": "{{document.number}}",
            "symbology": "code128",
            "show_text": true
          }
        ]
      }
    },
    {
      "name": "custom ID card page",
