            "content": "Issued {{date.issued}}",
            "style": { "font_family": "Noto Sans Ethiopic", "font_size_pt": 10 },
            "format": { "calendar": "ec", "date_pattern": "dd/MM/yyyy" }
          },
          {
            "id": "balance",
            "type": "text",
            "rect": { "x_mm": 140, "y_mm": 250, "w_mm": 50, "h_mm": 8 },
            "content": "{{fees.balance}}",
            "style": { "font_family": "Inter", "font_size_pt": 10 },
            "format": { "money": "etb", "number_decimals": 2 }
          }
        ]
      }
    },
    {
      "name": "letter page with bleed",
      "layout": {
        "version": 1,
        "page": {
          "size": "Letter",
          "orientation": "landscape",
          "bleed_mm": 5
        },
        "elements": [
          {
            "id": "body",
            "type": "text",
